# OpenRouter report generation
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# SMTP report delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_your_smtp_username
SMTP_PASSWORD=replace_with_your_smtp_password
SMTP_FROM_ADDRESS=reports@example.com
REPORT_RECIPIENT_EMAIL=recipient@example.com
