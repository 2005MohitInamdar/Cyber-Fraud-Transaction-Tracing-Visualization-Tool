# OpenRouter report generation
OPENROUTER_API_KEY=replace_with_your_openrouter_api_key
OPENROUTER_MODEL=openai/gpt-4o-mini

# SMTP report delivery
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_with_your_smtp_username
SMTP_PASSWORD=replace_with_your_smtp_password
SMTP_FROM_ADDRESS=reports@example.com
REPORT_RECIPIENT_EMAIL=recipient@example.com

# ── Requisition emails ────────────────────────────────────────────────────────
# If set, ALL requisition emails go ONLY to this address (test/staging mode).
# Remove or leave empty for real sending.
REQUISITION_TEST_RECIPIENT=

# Central delivery: when set (and TEST_RECIPIENT is NOT set), the SMTP envelope
# goes ONLY to this address. Bank addresses are recorded as intended recipients
# and an "Intended recipient" line is prepended to each delivered message.
# Leave empty to send directly to the banks (default direct-delivery mode).
REQUISITION_DELIVER_TO=

# Optional BCC for all outbound requisition emails (department archive).
REQUISITION_BCC=

# Optional legal reference line prepended to every requisition email body.
# Example: "Ref: Section 91 CrPC / Section 160 CrPC"
REQUISITION_LEGAL_REFERENCE=

# Maximum number of bank entries in one send request (default 25).
REQUISITION_MAX_BATCH=25

# ── Bank contact discovery ────────────────────────────────────────────────────
# Search provider for automatic bank email discovery.
# Values: "serper" | "brave" | "none"  (default: "none" = discovery disabled)
# With "none" set, the system still works — officers enter addresses manually.
SEARCH_PROVIDER=none

# API key for the chosen search provider (Serper or Brave).
# Get a key from https://serper.dev  or  https://api.search.brave.com/
SEARCH_API_KEY=

# How many days before an unverified discovered contact is re-checked (default: 30).
# Verified contacts are NEVER overwritten automatically.
CONTACT_RECHECK_DAYS=30
